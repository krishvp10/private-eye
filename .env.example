# PrivateEye Environment Configuration

# Server Settings
PE_SERVER_HOST=127.0.0.1
PE_SERVER_PORT=8000
PE_MOCK_VLM=1
PE_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
PE_VLLM_URL=http://localhost:8000/v1
PE_OLLAMA_URL=http://localhost:11434

# Preferred VLM configuration. Use PRIVATEEYE_VLM_MODE=real only when a
# reachable OpenAI-compatible multimodal endpoint is available.
PRIVATEEYE_VLM_MODE=mock
PRIVATEEYE_VLM_BASE_URL=http://127.0.0.1:8100/v1
PRIVATEEYE_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
PRIVATEEYE_VLM_API_KEY=

# Client Settings
PE_DEMO_URL=http://127.0.0.1:9001/kyc
PE_LOG_LEVEL=INFO
PE_CONFIRM_ACTIONS=false
PE_MAX_ACTION_RETRIES=2
PE_HEADLESS=true
PE_VIEWPORT_WIDTH=1280
PE_VIEWPORT_HEIGHT=800
PE_JPEG_QUALITY=70

# Security & Redaction Thresholds
PE_REDACT_CONFIDENCE_THRESHOLD=0.60
PE_STRICT_LEAK_CHECK=true
